{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenFood Menu Schema",
  "version": "0.1.0",
  "description": "A standardized schema for digital restaurant menus",
  "type": "object",
  "required": ["restaurant", "menu"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this schema was generated"
    },
    "restaurant": {
      "type": "object",
      "required": ["id", "name", "location", "currency", "language"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "currency": { "type": "string" },
        "language": { "type": "string" },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["kosher", "halal"]
          },
          "uniqueItems": true
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price"],
        "properties": {
          "id": { "type": "string" },

          "external_id": {
            "type": "string",
            "description": "External reference for POS, inventory, or ERP systems"
          },

          "name": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[a-z]{2}$": { "type": "string" }
            },
            "additionalProperties": false
          },

          "description": {
            "type": "object",
            "patternProperties": {
              "^[a-z]{2}$": { "type": "string" }
            },
            "additionalProperties": false
          },

          "category": { "type": "string" },

          "price": {
            "type": "number",
            "minimum": 0
          },

          "nutritional_info": {
            "type": "object",
            "properties": {
              "calories": { "type": "number", "minimum": 0 },
              "protein": { "type": "number", "minimum": 0 },
              "fat": { "type": "number", "minimum": 0 },
              "carbohydrates": { "type": "number", "minimum": 0 },
              "sugar": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },

          "allergens": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "crustaceans",
                "eggs",
                "fish",
                "peanuts",
                "soybeans",
                "milk",
                "nuts",
                "celery",
                "mustard",
                "sesame",
                "lupin",
                "sulphites",
                "molluscs",
                "gluten"
              ]
            },
            "uniqueItems": true
          },

          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vegan",
                "vegetarian",
                "gluten-free",
                "nut-free",
                "dairy-free",
                "organic"
              ]
            },
            "uniqueItems": true
          },

          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "amount_grams"],
              "properties": {
                "name": { "type": "string" },
                "amount_grams": { "type": "number", "minimum": 0 },
                "raw_or_cooked": {
                  "type": "string",
                  "enum": ["raw", "cooked"],
                  "default": "cooked"
                }
              },
              "additionalProperties": false
            }
          },

          "modifications": {
            "type": "array",
            "description": "Available modifications that can be made to this dish",
            "items": {
              "type": "object",
              "required": ["id", "name", "type"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-z]{2}$": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "type": {
                  "type": "string",
                  "enum": ["addition", "removal", "substitution", "option"]
                },
                "price_adjustment": { "type": "number" },
                "ingredient_id": { "type": "string" },
                "substitute": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "allergens": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "crustaceans",
                          "eggs",
                          "fish",
                          "peanuts",
                          "soybeans",
                          "milk",
                          "nuts",
                          "celery",
                          "mustard",
                          "sesame",
                          "lupin",
                          "sulphites",
                          "molluscs",
                          "gluten"
                        ]
                      },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "name"],
                    "properties": {
                      "id": { "type": "string" },
                      "name": {
                        "type": "object",
                        "minProperties": 1,
                        "patternProperties": {
                          "^[a-z]{2}$": { "type": "string" }
                        },
                        "additionalProperties": false
                      },
                      "price_adjustment": { "type": "number" },
                      "default": { "type": "boolean", "default": false },
                      "allergens": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "crustaceans",
                            "eggs",
                            "fish",
                            "peanuts",
                            "soybeans",
                            "milk",
                            "nuts",
                            "celery",
                            "mustard",
                            "sesame",
                            "lupin",
                            "sulphites",
                            "molluscs",
                            "gluten"
                          ]
                        },
                        "uniqueItems": true
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "max_selections": { "type": "integer", "minimum": 1 },
                "is_required": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether selection from this modification is mandatory"
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "option" } } },
                  "then": { "required": ["options"] }
                },
                {
                  "if": { "properties": { "type": { "const": "removal" } } },
                  "then": { "required": ["ingredient_id"] }
                },
                {
                  "if": {
                    "properties": { "type": { "const": "substitution" } }
                  },
                  "then": { "required": ["ingredient_id", "substitute"] }
                }
              ],
              "additionalProperties": false
            }
          },

          "custom_requests_allowed": {
            "type": "boolean",
            "default": false,
            "description": "Whether customers can enter free-text requests for this dish"
          },

          "spice_level": {
            "type": "string",
            "enum": ["mild", "medium", "hot", "extra hot"],
            "description": "Default spiciness level of the dish"
          },

          "availability": {
            "type": "object",
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
                }
              },
              "time_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9]$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^[0-2][0-9]:[0-5][0-9]$"
                  }
                },
                "required": ["start", "end"]
              }
            },
            "additionalProperties": false
          },

          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to an image of the dish"
          },

          "status": {
            "type": "string",
            "enum": ["available", "unavailable", "seasonal", "sold_out"],
            "default": "available",
            "description": "Current availability status of the dish"
          },

          "combo_items": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "IDs of other dishes included in this combo"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
