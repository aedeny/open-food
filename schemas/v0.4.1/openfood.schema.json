{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenFood Menu Schema",
  "version": "0.4.0",
  "description": "A standardized schema for digital restaurant menus",
  "type": "object",
  "required": [
    "openfood_version",
    "restaurant",
    "menu"
  ],
  "definitions": {
    "localizedText": {
      "type": "object",
      "description": "Text localized by two-letter ISO 639-1 language code, optionally with an ISO 3166-1 region subtag (e.g. 'en', 'pt-BR')",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "timeOfDay": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "timeRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/definitions/timeOfDay"
        },
        "end": {
          "$ref": "#/definitions/timeOfDay"
        }
      },
      "additionalProperties": false
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "crustaceans",
          "eggs",
          "fish",
          "peanuts",
          "soybeans",
          "milk",
          "nuts",
          "celery",
          "mustard",
          "sesame",
          "lupin",
          "sulphites",
          "molluscs",
          "gluten"
        ]
      },
      "uniqueItems": true
    },
    "advisories": {
      "type": "array",
      "uniqueItems": true,
      "description": "Preparation facts a diner may need to avoid. Factual only — an empty array means the kitchen checked and none apply; an absent field means nobody checked, which is not the same thing and must not be read as safe.",
      "items": {
        "type": "string",
        "enum": [
          "alcohol",
          "raw-fish",
          "raw-shellfish",
          "raw-meat",
          "raw-egg",
          "unpasteurized-dairy",
          "cured-meat",
          "high-mercury-fish",
          "liver",
          "sprouts",
          "honey"
        ],
        "description": "alcohol: contains alcohol as an ingredient, whether or not it is cooked off. raw-fish: raw or cold-cured fish (sashimi, ceviche, tartare, cold-smoked salmon). raw-shellfish: raw shellfish (oysters, clams). Distinct from raw-fish: different risk, different allergen. raw-meat: raw or lightly seared meat (tartare, carpaccio, rare-by-default burger). raw-egg: raw or lightly cooked egg. Excludes pasteurised egg product — commercial mayonnaise is pasteurised, house mayonnaise usually is not. unpasteurized-dairy: milk or cheese made from unpasteurised milk. cured-meat: ready-to-eat cured or fermented meat NOT cooked before serving (prosciutto, salami, chorizo). Hot-smoked or cooked ham does not qualify. high-mercury-fish: shark, swordfish, king mackerel, marlin, or bigeye tuna. Note this needs a species list rather than a kitchen fact; declare it only when the species is one of these. liver: contains liver or liver pate. sprouts: raw sprouted seeds (alfalfa, mung bean). honey: contains honey. An infant advisory (botulism, under 12 months), not a pregnancy one."
      }
    }
  },
  "properties": {
    "openfood_version": {
      "type": "string",
      "description": "Version of the OpenFood schema this document conforms to",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this document was generated"
    },
    "restaurant": {
      "type": "object",
      "required": [
        "id",
        "name",
        "location",
        "currency",
        "default_language"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/definitions/localizedText"
        },
        "description": {
          "$ref": "#/definitions/localizedText"
        },
        "location": {
          "type": "object",
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code"
            },
            "postal_code": {
              "type": "string"
            },
            "geo": {
              "type": "object",
              "required": [
                "lat",
                "lng"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code applying to all prices in this document"
        },
        "default_language": {
          "$ref": "#/definitions/languageCode",
          "description": "Language used as fallback when a translation is missing"
        },
        "languages": {
          "type": "array",
          "description": "Languages this menu provides translations for",
          "items": {
            "$ref": "#/definitions/languageCode"
          },
          "uniqueItems": true
        },
        "cuisines": {
          "type": "array",
          "description": "Cuisine styles, lowercase (e.g. 'italian', 'japanese', 'middle-eastern')",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "uniqueItems": true
        },
        "contact": {
          "type": "object",
          "properties": {
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "website": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "links": {
          "type": "object",
          "description": "Links to the restaurant's presence on external platforms (e.g. google_maps, tripadvisor, wolt)",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "hours": {
          "type": "object",
          "description": "Opening hours per weekday; multiple ranges allow split shifts",
          "propertyNames": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/timeRange"
            }
          }
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to a cover image of the restaurant"
        },
        "logo_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the restaurant's logo"
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "kosher",
              "halal"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "description": "Menu categories; dishes reference these by category_id",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "$ref": "#/definitions/localizedText"
          },
          "description": {
            "$ref": "#/definitions/localizedText"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "external_id": {
            "type": "string",
            "description": "External reference for POS, inventory, or ERP systems"
          },
          "name": {
            "$ref": "#/definitions/localizedText"
          },
          "description": {
            "$ref": "#/definitions/localizedText"
          },
          "category_id": {
            "type": "string",
            "description": "ID of the category this dish belongs to"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "description": "Display position within the category"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "nutritional_info": {
            "type": "object",
            "properties": {
              "calories": {
                "type": "number",
                "minimum": 0
              },
              "protein": {
                "type": "number",
                "minimum": 0
              },
              "fat": {
                "type": "number",
                "minimum": 0
              },
              "carbohydrates": {
                "type": "number",
                "minimum": 0
              },
              "sugar": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "allergens": {
            "$ref": "#/definitions/allergens"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vegan",
                "vegetarian",
                "gluten-free",
                "nut-free",
                "dairy-free",
                "organic"
              ]
            },
            "uniqueItems": true
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount_grams": {
                  "type": "number",
                  "minimum": 0
                },
                "raw_or_cooked": {
                  "type": "string",
                  "enum": [
                    "raw",
                    "cooked"
                  ],
                  "default": "cooked"
                }
              },
              "additionalProperties": false
            }
          },
          "option_groups": {
            "type": "array",
            "description": "Configurable choices for this dish (toppings, sizes, sauces, substitutions). Each group is a set of options with selection rules; together they can express anything from 'pick one sauce' to a half-and-half pizza with priced extras.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "$ref": "#/definitions/localizedText"
                },
                "description": {
                  "$ref": "#/definitions/localizedText"
                },
                "min_selections": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0,
                  "description": "Minimum number of selections (counting quantities); > 0 makes the group required"
                },
                "max_selections": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Maximum number of selections (counting quantities); omit for unlimited"
                },
                "included_selections": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0,
                  "description": "Number of selections included in the dish's base price. Selections beyond this count are charged their price_adjustment; within it they are free."
                },
                "portions": {
                  "type": "object",
                  "required": [
                    "divisions"
                  ],
                  "description": "When present, each selected option may be applied to a fraction of the dish (e.g. pizza halves or quarters) instead of the whole.",
                  "properties": {
                    "divisions": {
                      "type": "integer",
                      "enum": [
                        2,
                        3,
                        4,
                        6,
                        8
                      ],
                      "description": "How many equal parts the dish can be split into (2 = halves, 4 = quarters)"
                    },
                    "pricing": {
                      "type": "string",
                      "enum": [
                        "proportional",
                        "full"
                      ],
                      "default": "proportional",
                      "description": "proportional: an option on 1/N of the dish costs 1/N of its price_adjustment; full: it costs the full price_adjustment regardless of coverage"
                    }
                  },
                  "additionalProperties": false
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "$ref": "#/definitions/localizedText"
                      },
                      "description": {
                        "$ref": "#/definitions/localizedText"
                      },
                      "price_adjustment": {
                        "type": "number",
                        "description": "Price change per selected unit (may be negative); subject to included_selections and portions pricing"
                      },
                      "default": {
                        "type": "boolean",
                        "default": false
                      },
                      "max_quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "default": 1,
                        "description": "How many times this option may be selected (e.g. 2 = allow double)"
                      },
                      "allergens": {
                        "$ref": "#/definitions/allergens"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "vegan",
                            "vegetarian",
                            "gluten-free",
                            "nut-free",
                            "dairy-free",
                            "organic"
                          ]
                        }
                      },
                      "advisories": {
                        "$ref": "#/definitions/advisories"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "contains_alcohol": {
            "type": "boolean",
            "default": false,
            "deprecated": true,
            "description": "Deprecated since 0.4.0 — use advisories: [\"alcohol\"]. Still accepted so documents published under 0.3.0 remain valid. Readers should treat true as the alcohol advisory and false as no statement about any other advisory."
          },
          "custom_requests_allowed": {
            "type": "boolean",
            "default": false,
            "description": "Whether customers can enter free-text requests for this dish"
          },
          "spice_level": {
            "type": "string",
            "enum": [
              "mild",
              "medium",
              "hot",
              "extra hot"
            ],
            "description": "Default spiciness level of the dish"
          },
          "availability": {
            "type": "object",
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                }
              },
              "time_range": {
                "$ref": "#/definitions/timeRange"
              }
            },
            "additionalProperties": false
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to an image of the dish"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "seasonal",
              "sold_out"
            ],
            "default": "available",
            "description": "Current availability status of the dish"
          },
          "combo_items": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "IDs of other dishes included in this combo"
            }
          },
          "advisories": {
            "$ref": "#/definitions/advisories"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
